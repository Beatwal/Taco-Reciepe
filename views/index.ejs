<!DOCTYPE html>
<html>

<head>
  <title>Taco receipes</title>
  <link rel="stylesheet" type="text/css" href="/styles/main.css">
</head>

<body>
  <h1>Taco Town 🌮</h1>

  <form action="/receipe" method="POST" class="buttons">
    <button type="submit" value="chicken" name="choice">🍗</button>
    <button type="submit" value="beef" name="choice">🥩</button>
    <button type="submit" value="fish" name="choice">🐟</button>
  </form>
  
  <div id="receipeContainer" class="hidden">

<% if (receipe) {%>

  <h2><%=receipe.name %></h2>
  <h3>Ingredients:</h3>
  <ul id="ingredientsList">
    <li><%=receipe.ingredients.protein.name%>,<%=receipe.ingredients.protein.preparation%></li>
    <li><%=receipe.ingredients.salsa.name%><%=receipe.ingredients.salsa.spiciness%></li>
     <%receipe.ingredients.toppings.forEach(topping=>{%>
       <li><%=topping.name%>,<%=topping.quantity%></li>
     <%})%>
    
         
  
  </ul>
<%}else{%>

<h2 id="pick">Pick your favourite taco ingredient 👆</h2>

<% } %>


  </div>
</body>

</html>